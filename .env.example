# marc-agent — secretos. Copia a .env en el SERVIDOR (chmod 600) y rellena allí.
# Nunca subas .env a git ni lo compartas por chat.

# --- Telegram (BotFather) ---
TELEGRAM_BOT_TOKEN=
# Tu id numérico de usuario de Telegram (único usuario autorizado)
TELEGRAM_USER_ID=

# --- Anthropic (Console > API keys) ---
ANTHROPIC_API_KEY=

# --- Google Cloud (OAuth client de tipo "Desktop app") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# API key restringida SOLO a Cloud Speech-to-Text API
GOOGLE_STT_API_KEY=

# --- Brave Search API ---
BRAVE_API_KEY=

# --- Cifrado: NO las escribas a mano. Ejecuta `make init-keys` en el servidor: las genera
#     y las añade aquí sin mostrarlas. Guarda copia de BACKUP y EXPORT en tu gestor de contraseñas. ---
MARC_DATA_KEY=
MARC_BACKUP_KEY=
MARC_EXPORT_KEY=
# Solo durante una rotación de clave (ver README §4)
MARC_DATA_KEY_PREVIOUS=
